		"devdoc": {
			"events": {
				"Approval(address,address,uint256)": {
					"details": "释放条件：当 `value` 单位的货币从账户 (`owner`) 授权给另一账户 (`spender`)时."
				},
				"Transfer(address,address,uint256)": {
					"details": "释放条件：当 `value` 单位的货币从账户 (`from`) 转账到另一账户 (`to`)时."
				}
			},
			"kind": "dev",
			"methods": {
				"approve(address,uint256)": {
					"details": "调用者账户给`spender`账户授权 `amount`数量代币。 如果成功，返回 `true`. 释放 {Approval} 事件. 函数\t        调用者\t    关键参数\t影响的存储 approve\t        代币拥有者\tspender\t    allowance[msg.sender][spender] transferFrom\t被授权者\tfrom\t    allowance[from][msg.sender] 记住这个对应关系： approve 的 msg.sender = transferFrom 的 from approve 的 spender = transferFrom 的 msg.sender"
				},
				"transfer(address,uint256)": {
					"details": "转账 `amount` 单位代币，从调用者账户到另一账户 `to`. 如果成功，返回 `true`. 释放 {Transfer} 事件."
				},
				"transferFrom(address,address,uint256)": {
					"details": "通过授权机制，从`from`账户向`to`账户转账`amount`数量代币。转账的部分会从调用者的`allowance`中扣除。 如果成功，返回 `true`. 释放 {Transfer} 事件."
				}
			},
			"stateVariables": {
				"allowance": {
					"details": "返回`owner`账户授权给`spender`账户的额度，默认为0。 当{approve} 或 {transferFrom} 被调用时，`allowance`会改变."
				},
				"balanceOf": {
					"details": "返回账户`account`所持有的代币数."
				},
				"totalSupply": {
					"details": "返回代币总供给."
				}
			},
			"version": 1
		},
